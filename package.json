{
  "name": "echo-plugin",
  "version": "0.1.5",
  "description": "A simple echo Orbit plugin",
  "type": "module",
  "main": "dist/index.js",
  "keywords": [
    "openclaw",
    "plugin",
    "orbit"
  ],
  "license": "ISC",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "orbit:publish": "orbit-publish"
  },
  "dependencies": {
    "@orbit-0g/sdk": "^0.1.25",
    "@sinclair/typebox": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "openclaw": "latest",
    "typescript": "latest"
  },
  "peerDependencies": {
    "openclaw": ">=2026.2.0"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.12"
    },
    "build": {
      "openclawVersion": "2026.5.12",
      "pluginSdkVersion": "2026.5.12"
    }
  }
}
